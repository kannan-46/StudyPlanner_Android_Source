# Use the MongoDB Atlas connection string. Keep its password on the API host only.
MONGODB_URI=mongodb+srv://replace-me:replace-me@your-cluster.example.mongodb.net/surgical_study_planner?retryWrites=true&w=majority

# Generate a private random value of at least 32 characters for each deployment.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
PORT=3000
ALLOW_REGISTRATION=false

# Leave at 0 unless the API host sits behind a known reverse proxy; then set its hop count.
TRUST_PROXY_HOPS=0
