{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/server.ts": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/api/server/(?<path>.*)",
      "dest": "/api/server",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$path"
        }
      ]
    }
  ]
}
