# MongoDB Atlas connection string. Keep its password on the API host only.
MONGODB_URI=mongodb+srv://replace-me:replace-me@your-cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=studyplanner

# Private random value of at least 32 characters for each deployment.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# Web OAuth client id used to verify Google ID tokens.
GOOGLE_WEB_CLIENT_ID=replace-me.apps.googleusercontent.com

PORT=3000

# Leave at 0 unless behind a known reverse proxy (Vercel sets 1 automatically).
TRUST_PROXY_HOPS=0

# Local development only; refused when VERCEL is set.
DEV_GOOGLE_STUB=false
